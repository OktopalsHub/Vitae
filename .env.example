# Copy to .env and fill in values:
#   cp .env.example .env
#
# B2C Job Match — required for Cloud: SECRET_KEY, FERNET_SECRET_KEY,
# DATABASE_URL (Postgres), OAUTH_REDIRECT_BASE, and Bachs webhook secret.

# ---------------------------------------------------------------------------
# Cloud / staging checklist (FastAPI Cloud)
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_HOST=0.0.0.0
# DATABASE_URL=postgresql://…  (Neon — never SQLite in Cloud)
# SECRET_KEY=<long-random-secret>
# FERNET_SECRET_KEY=<Fernet.generate_key()>
# OAUTH_REDIRECT_BASE=https://your-app.fastapicloud.dev
# SITE_URL=https://your-app.fastapicloud.dev
# GOOGLE_SITE_VERIFICATION=<meta content from Search Console>
# BACHS_API_KEY=sk_live_…   (or sk_sandbox_… for testing)
# BACHS_WEBHOOK_SECRET=<from Bachs dashboard>
# BACHS_PRODUCT_BYOK_NG=prod_… / PLATFORM_NG / BYOK_INTL / PLATFORM_INTL
# GEMINI_API_KEY=…   (or OPENAI_API_KEY for Platform AI)
# ADZUNA_APP_ID=… / ADZUNA_APP_KEY=…  (optional)
# TRUST_EDGE_GEO defaults to on (NG vs intl from CF/Vercel country headers).
#   Set TRUST_EDGE_GEO=0 only locally to ignore geo (headers spoofable without an edge).

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Set RATE_LIMIT_BACKEND=redis + REDIS_URL when web replicas must share limits.
REDIS_URL=
RATE_LIMIT_BACKEND=local
APP_HOST=127.0.0.1
APP_PORT=8765
# development | production | cloud
APP_ENV=development
# Local: SQLite is fine. FastAPI Cloud: use Postgres (Neon recommended).
DATABASE_URL=sqlite:///./data/jobs.db
# Max CV upload size in bytes (default 8MB)
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Auth / cookies / OAuth
# ---------------------------------------------------------------------------
SECRET_KEY=dev-insecure-secret-change-me-32b+
# Optional separate key for encrypting BYOK LLM keys at rest.
# Recommended in Cloud so JWT rotation does not wipe stored API keys.
# FERNET_SECRET_KEY=
# Public site URL (no trailing slash). Used for OAuth + checkout redirects.
# Local:  http://127.0.0.1:8765
# Cloud:  https://your-app.fastapicloud.dev
OAUTH_REDIRECT_BASE=http://127.0.0.1:8765
# Canonical URLs, sitemap, llms.txt. Defaults to OAUTH_REDIRECT_BASE if unset.
SITE_URL=
# Google Search Console (HTML tag method) — content="..." value only
GOOGLE_SITE_VERIFICATION=

# Optional Google — redirect URI: {OAUTH_REDIRECT_BASE}/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional GitHub — redirect URI: {OAUTH_REDIRECT_BASE}/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Platform LLM keys (Platform AI plan — server-owned only)
# Supported: OpenAI or Gemini. Users on BYOK add keys in Settings.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional when both are set: openai | gemini
LLM_PROVIDER=

# ---------------------------------------------------------------------------
# Bachs billing — https://docs.bachs.io  (sandbox: sandbox-api.bachs.io)
# Four monthly recurring products:
#   NG  → NGN ₦2,000 BYOK · ₦5,000 Platform
#   intl → USD $5 BYOK · $10 Platform
# Webhook URL: {OAUTH_REDIRECT_BASE}/webhooks/bachs
# Subscribe to: checkout.completed, collection.succeeded,
#   customer.subscription.created|updated|deleted,
#   invoice.paid, invoice.payment_failed
# Unsigned webhooks are only accepted in development/test when secret is unset.
# ---------------------------------------------------------------------------
BACHS_API_KEY=
# Optional; defaults from key prefix (sandbox-api.bachs.io vs api.bachs.io)
BACHS_API_BASE=
# Required in Cloud / staging
BACHS_WEBHOOK_SECRET=
# Product IDs (prod_…) — NGN for NG, USD for intl
BACHS_PRODUCT_BYOK_NG=          # ₦2,000 NGN monthly
BACHS_PRODUCT_PLATFORM_NG=      # ₦5,000 NGN monthly
BACHS_PRODUCT_BYOK_INTL=        # $5 USD monthly
BACHS_PRODUCT_PLATFORM_INTL=    # $10 USD monthly

# Geo pricing: default on. Set 0 locally to force intl USD products.
# TRUST_EDGE_GEO=0

# ---------------------------------------------------------------------------
# Optional job sources
# ---------------------------------------------------------------------------
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=
