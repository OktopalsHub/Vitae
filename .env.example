# Copy to .env and fill in values:
#   cp .env.example .env
#
# B2C Job Match — required for Cloud: SECRET_KEY, DATABASE_URL (Postgres),
# OAUTH_REDIRECT_BASE, and Bachs webhook secret.

# ---------------------------------------------------------------------------
# Cloud production checklist (FastAPI Cloud)
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_HOST=0.0.0.0
# DATABASE_URL=postgresql://…  (Neon — never SQLite in Cloud)
# SECRET_KEY=<long-random-secret>
# OAUTH_REDIRECT_BASE=https://your-app.fastapicloud.dev
# SITE_URL=https://your-app.fastapicloud.dev
# GOOGLE_SITE_VERIFICATION=<meta content from Search Console>
# BACHS_API_KEY=sk_live_…   (or sk_sandbox_… for testing)
# BACHS_WEBHOOK_SECRET=<from Bachs dashboard>
# BACHS_WEBHOOK_DEV_ACCEPT=0
# TRUST_EDGE_GEO=1   # Cloud only — CF/Vercel country → NG vs intl Bachs products
# BACHS_PRODUCT_BYOK_NG=prod_… / PLATFORM_NG / BYOK_INTL / PLATFORM_INTL (4 USD monthly)
# GEMINI_API_KEY=…   (or OPENAI_API_KEY for Platform AI — OpenAI / Gemini only)
# ADZUNA_APP_ID=… / ADZUNA_APP_KEY=…  (optional but improves catalogue)

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8765
# development | production | cloud
# production/cloud with the default SECRET_KEY will refuse to start
APP_ENV=development
# Local: SQLite is fine. FastAPI Cloud: use Postgres (Neon recommended).
DATABASE_URL=sqlite:///./data/jobs.db
# Max CV upload size in bytes (default 8MB)
MAX_UPLOAD_BYTES=10485760
# Background catalogue sync (default: every hour after a short startup delay)
# CATALOGUE_SYNC_DISABLED=1
# CATALOGUE_SYNC_INTERVAL_SECONDS=3600
# CATALOGUE_SYNC_STARTUP_DELAY_SECONDS=2
# Refresh existing user_jobs rankings (default: every 3 hours)
# USER_RANK_REFRESH_DISABLED=1
# USER_RANK_INTERVAL_SECONDS=10800
# USER_RANK_STARTUP_DELAY_SECONDS=120

# ---------------------------------------------------------------------------
# Auth / cookies / OAuth
# ---------------------------------------------------------------------------
# Signs JWT cookies. Required strong unique value in production/cloud.
SECRET_KEY=dev-insecure-secret-change-me-32b+
# Optional separate key for encrypting BYOK LLM keys at rest.
# Recommended in Cloud so JWT rotation does not wipe stored API keys.
# When set, ciphertext encrypted with the old SECRET_KEY-derived Fernet
# can still be decrypted until users re-save their keys.
# FERNET_SECRET_KEY=
# In-process rate limits (requests per 60 seconds). Set 0 to disable.
# RATE_LIMIT_AUTH=10
# RATE_LIMIT_PASTE=20
# RATE_LIMIT_AI=15
# Public site URL (no trailing slash). Used for OAuth + checkout redirects.
# Local:  http://127.0.0.1:8765
# Cloud:  https://your-app.fastapicloud.dev
OAUTH_REDIRECT_BASE=http://127.0.0.1:8765
# Canonical URLs, sitemap, llms.txt. Defaults to OAUTH_REDIRECT_BASE if unset.
SITE_URL=
# Google Search Console (HTML tag method):
#   1. Add property in Search Console with URL prefix = SITE_URL
#   2. Choose "HTML tag" verification — copy only the content="..." value below
#   3. Redeploy, open home page, click Verify in Search Console
#   4. Sitemaps → submit {SITE_URL}/sitemap.xml
GOOGLE_SITE_VERIFICATION=

# Optional Google — buttons always show; without these keys Google returns a setup message.
# Console redirect URI must match exactly:
#   {OAUTH_REDIRECT_BASE}/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional GitHub — same pattern:
#   {OAUTH_REDIRECT_BASE}/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Platform LLM keys (Platform AI plan — server-owned only)
# Supported: OpenAI or Gemini. Users on BYOK add DeepSeek/Grok/etc in Settings
# (encrypted in DB with FERNET_SECRET_KEY or SECRET_KEY) — never put user BYOK keys here.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional when both are set: openai | gemini
LLM_PROVIDER=

# ---------------------------------------------------------------------------
# Bachs billing — https://docs.bachs.io  (sandbox: sandbox-api.bachs.io)
# Four monthly recurring products:
#   NG  → NGN ₦2,000 BYOK · ₦5,000 Platform
#   intl → USD $5 BYOK · $10 Platform
# Create with billing_cycle {interval: month, frequency: 1}.
# Webhook URL: {OAUTH_REDIRECT_BASE}/webhooks/bachs
# Subscribe to: checkout.completed, collection.succeeded,
#   customer.subscription.created|updated|deleted,
#   invoice.paid, invoice.payment_failed
# ---------------------------------------------------------------------------
# Sandbox: sk_sandbox_… · Live: sk_live_…
BACHS_API_KEY=
# Optional; defaults from key prefix (sandbox-api.bachs.io vs api.bachs.io)
BACHS_API_BASE=
# Required in Cloud. HMAC of "{timestamp}.{raw_body}" (X-Bachs-Timestamp + Signature)
BACHS_WEBHOOK_SECRET=
# Local only: accept unsigned webhooks if secret unset (never in production/cloud)
BACHS_WEBHOOK_DEV_ACCEPT=0
# Sandbox product IDs (prod_…) — NGN for NG, USD for intl
BACHS_PRODUCT_BYOK_NG=          # ₦2,000 NGN monthly
BACHS_PRODUCT_PLATFORM_NG=      # ₦5,000 NGN monthly
BACHS_PRODUCT_BYOK_INTL=        # $5 USD monthly
BACHS_PRODUCT_PLATFORM_INTL=    # $10 USD monthly

# Pricing geo: only enable behind Cloudflare / CloudFront / Vercel.
# When false (default), all checkouts use intl ($). Never trust client cookies.
TRUST_EDGE_GEO=0

# ---------------------------------------------------------------------------
# Optional job sources
# ---------------------------------------------------------------------------
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=
