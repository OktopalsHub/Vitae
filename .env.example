# Copy to .env and fill in values:
#   cp .env.example .env
#
# Production requires: SECRET_KEY, FERNET_SECRET_KEY, DATABASE_URL,
# OAUTH_REDIRECT_BASE, Bachs billing secrets/products, and R2 storage.

# ---------------------------------------------------------------------------
# Cloud / staging checklist
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_HOST=0.0.0.0
# DATABASE_URL=postgresql://…
# SECRET_KEY=<long-random-secret>
# FERNET_SECRET_KEY=<Fernet.generate_key()>
# OAUTH_REDIRECT_BASE=https://your-domain.example
# SITE_URL=https://your-domain.example
# BACHS_API_KEY=sk_live_…   (or sk_sandbox_… for testing)
# BACHS_WEBHOOK_SECRET=<from Bachs dashboard>
# BACHS_PRODUCT_BYOK_NG=prod_…
# BACHS_PRODUCT_PLATFORM_NG=prod_…
# BACHS_PRODUCT_BYOK_INTL=prod_…
# BACHS_PRODUCT_PLATFORM_INTL=prod_…
# GEMINI_API_KEY=…   (or OPENAI_API_KEY for Platform AI)
# R2_ACCOUNT_ID=<cloudflare-account-id>
# R2_ACCESS_KEY_ID=<r2-access-key-id>
# R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
# R2_BUCKET_NAME=vitae-production

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
REDIS_URL=
RATE_LIMIT_BACKEND=local
FORWARDED_ALLOW_IPS=127.0.0.1
# Optional bearer token for the protected /metrics endpoint.
# METRICS_TOKEN=
APP_HOST=127.0.0.1
APP_PORT=8765
# development | production | cloud
APP_ENV=development
DATABASE_URL=sqlite:///./data/jobs.db
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Auth / cookies / OAuth
# ---------------------------------------------------------------------------
SECRET_KEY=
FERNET_SECRET_KEY=
OAUTH_REDIRECT_BASE=http://127.0.0.1:8765
SITE_URL=
GOOGLE_SITE_VERIFICATION=

# Optional Google — redirect URI: {OAUTH_REDIRECT_BASE}/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional GitHub — redirect URI: {OAUTH_REDIRECT_BASE}/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Platform LLM keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional when both are set: openai | gemini
LLM_PROVIDER=

# ---------------------------------------------------------------------------
# Bachs billing
# ---------------------------------------------------------------------------
BACHS_API_KEY=
BACHS_API_BASE=
BACHS_WEBHOOK_SECRET=
BACHS_PRODUCT_BYOK_NG=
BACHS_PRODUCT_PLATFORM_NG=
BACHS_PRODUCT_BYOK_INTL=
BACHS_PRODUCT_PLATFORM_INTL=
# TRUST_EDGE_GEO=0

# ---------------------------------------------------------------------------
# Optional job sources
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# ---------------------------------------------------------------------------
# Cloudflare R2 artifact storage
# ---------------------------------------------------------------------------
OBJECT_STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
